{
  "manifest_version": 3,
  "name": "Imagine · Browser Read",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Imagine · 授權目前分頁並開啟側欄"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
