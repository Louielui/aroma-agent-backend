+function Set-MonitorOperation([string]$Phase,[string]$CallSite,$EventId=$null,$SourceIdentifier=$null) {
+  $script:operation=@{phase=$Phase;callSite=$CallSite;eventId=$EventId;sourceIdentifier=$SourceIdentifier;recordAppended=$null;removeAcknowledged=$null;priorRecordAppended=$null;priorRemoveAcknowledged=$null}
+}
+function Save-MonitorFailure($ErrorValue) {
+  if($null-eq $script:monitorFailure) {
+    $message=if($ErrorValue-is [System.Management.Automation.ErrorRecord]){$ErrorValue.Exception.Message}else{[string]$ErrorValue}
+    $script:monitorFailure=@{pid=$PID;error=$message;terminal=$true;traceIntegrity='NOT_ESTABLISHED'}
+    foreach($key in $script:operation.Keys){$script:monitorFailure[$key]=$script:operation[$key]}
+  }
+}
+function Write-MonitorReceipt([string]$Name,$Value) {
+  $bytes=[Text.UTF8Encoding]::new($false).GetBytes(($Value|ConvertTo-Json -Depth 6 -Compress))
+  if($bytes.Length-gt 3000000){throw 'monitor_receipt_size_exceeded'}
+  $tmp=Join-Path $PrivateRoot ($Name+'.tmp')
+  $stream=[IO.File]::Open($tmp,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
+  try {$stream.Write($bytes,0,$bytes.Length);$stream.Flush($true)} finally {$stream.Dispose()}
+  [IO.File]::Move($tmp,(Join-Path $PrivateRoot $Name))
+}
+function Collect-MonitorEvent($QueuedEvent,[string]$Phase) {
+  $site=if($Phase-eq 'POLLING'){'polling'}elseif($Phase-eq 'POST_STOP_DRAIN'){'post_stop_drain'}else{'finally_cleanup'}
+  Set-MonitorOperation $Phase ($site+'.read_event_identity')
+  $id=[int]$QueuedEvent.EventIdentifier;$source=[string]$QueuedEvent.SourceIdentifier
+  $script:operation.eventId=$id;$script:operation.sourceIdentifier=$source
+  if($id-le 0-or -not $ownedSources.Contains($source)){throw 'monitor_event_not_owned'}
+  $script:operation.callSite=$site+'.read_payload'
+  $n=$QueuedEvent.SourceEventArgs.NewEvent
+  if($null-eq $n){throw 'monitor_event_payload_missing'}
+  $key=$source+':'+$id+':'+[string]$n.TIME_CREATED
+  if($eventHistory.ContainsKey($key)) {
+    $script:operation.priorRecordAppended=$eventHistory[$key].recordAppended
+    $script:operation.priorRemoveAcknowledged=$eventHistory[$key].removeAcknowledged
+  }
+  $script:operation.callSite=$site+'.append_trace'
+  if($eventsList.Count-ge 5000){throw 'process_trace_bound_exceeded'}
+  if(((Get-Date)-$started).TotalSeconds-gt 180){throw 'process_trace_window_expired'}
+  $eventsList.Add(@{kind=$source;pid=[int]$n.ProcessID;parent=if($source-eq 'r1-start'){[int]$n.ParentProcessID}else{$null};name=[string]$n.ProcessName;exit=if($source-eq 'r1-stop'){[uint32]$n.ExitStatus}else{$null};traceTime=[string]$n.TIME_CREATED;observedAt=(Get-Date).ToUniversalTime().ToString('o')})
+  $script:operation.recordAppended=$true
+  if(-not $eventHistory.ContainsKey($key)){$eventHistory[$key]=@{recordAppended=$null;removeAcknowledged=$null}}
+  $eventHistory[$key].recordAppended=$true
+  $script:operation.callSite=$site+'.remove_event'
+  if($failedRemovals.Contains($source+':'+$id)){throw 'monitor_event_removal_already_failed'}
+  try {Remove-Event -EventIdentifier $id -ErrorAction Stop}
+  catch {[void]$failedRemovals.Add($source+':'+$id);throw}
+  $script:operation.removeAcknowledged=$true
+  $eventHistory[$key].removeAcknowledged=$true
+}
